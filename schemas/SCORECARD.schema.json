{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository Audit Scorecard",
  "description": "Machine-readable audit scorecard with 5 dimensions (D1-D5), composite score, T1/T2 tier checks, and metadata.",
  "type": "object",
  "required": ["dimensions", "composite", "max_composite", "tier1_checks", "meta"],
  "properties": {
    "dimensions": {
      "type": "object",
      "required": [
        "D1_governance",
        "D2_surface_health",
        "D3_skill_maturity",
        "D4_measurement",
        "D5_self_improvement"
      ],
      "patternProperties": {
        "^D[1-5]_": {
          "type": "object",
          "required": ["score", "max", "tier", "components"],
          "properties": {
            "score": { "type": "integer", "minimum": 0, "maximum": 20 },
            "max": { "type": "integer", "const": 20 },
            "tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
            "components": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "score": { "type": "integer" },
                  "max": { "type": "integer" },
                  "detail": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "composite": { "type": "integer", "minimum": 0, "maximum": 100 },
    "max_composite": { "type": "integer", "const": 100 },
    "tier1_checks": {
      "type": "object",
      "required": ["total", "passed", "failed", "failures"],
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "failures": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tier2_warnings": {
      "type": "object",
      "properties": {
        "total": { "type": "integer" },
        "triggered": { "type": "integer" },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "receipts": {
      "type": "object",
      "properties": {
        "file": { "type": "string" },
        "version": { "type": "string" },
        "count_reconciliation_status": { "type": "string" },
        "target_native_quality_gates": {
          "type": "object",
          "required": ["file", "version", "status", "target_gate_state", "contradiction"],
          "properties": {
            "file": { "type": "string", "const": "TARGET_NATIVE_QUALITY_GATES.json" },
            "version": { "type": "string" },
            "status": { "type": "string", "enum": ["present"] },
            "target_gate_state": { "type": "string", "enum": ["pass", "fail", "warning", "unknown"] },
            "contradiction": {
              "type": "string",
              "enum": [
                "target_policy_explained",
                "unresolved",
                "true_target_risk",
                "fleet_metric_stale",
                "partial_run_no_verdict",
                "unclassified_requires_amendment"
              ]
            }
          }
        },
        "dual_inventory": {
          "type": "object",
          "required": [
            "file",
            "version",
            "primary_surface_inventory_status",
            "full_facts_inventory_status",
            "non_authorization"
          ],
          "properties": {
            "file": { "type": "string", "const": "SCORECARD_RECEIPTS.json" },
            "version": { "type": "string" },
            "primary_surface_inventory_status": {
              "type": "string",
              "enum": ["available", "available_empty", "available_limited", "unavailable"]
            },
            "primary_surface_count": { "type": "integer", "minimum": 0 },
            "full_facts_inventory_status": {
              "type": "string",
              "enum": ["available", "available_limited", "unavailable"]
            },
            "full_facts_total_files_scanned": { "type": "integer", "minimum": 0 },
            "full_facts_scan_limit_guidance_status": {
              "type": "string",
              "enum": ["not_needed", "measure_denominator", "rerun_with_higher_cap", "not_applicable"]
            },
            "full_facts_minimum_complete_cap": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "full_facts_recommended_rerun_cap": {
              "type": ["integer", "null"],
              "minimum": 1
            },
            "full_facts_trusted_local_override": {
              "type": ["string", "null"]
            },
            "non_authorization": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["phase", "maturity_score", "timestamp", "auditor_version"],
      "properties": {
        "phase": { "type": "string" },
        "maturity_score": { "type": "integer" },
        "agents": { "type": "integer" },
        "skills": { "type": "integer" },
        "timestamp": { "type": "string", "format": "date-time" },
        "auditor_version": { "type": "string" }
      }
    }
  }
}
